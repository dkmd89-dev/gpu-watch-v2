# Kopieren nach ".env" und Werte anpassen. Siehe README.md, Abschnitt
# "Konfiguration" fuer die Bedeutung jeder Variable.

# Push-Benachrichtigungen (ntfy.sh oder eigene Instanz). Ohne NTFY_TOPIC
# werden keine Benachrichtigungen verschickt.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Abstand zwischen zwei Scan-Durchlaeufen in Minuten.
SCAN_INTERVAL_MINUTES=10

# Obergrenzen fuer die lokale Datenhaltung (siehe data/).
FOUND_MAX_ITEMS=200
DEAL_MAX_AGE_DAYS=7
SEEN_MAX_ITEMS=50000
SEEN_DELISTED_MAX_AGE_DAYS=3
